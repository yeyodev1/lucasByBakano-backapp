# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/lucas
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@cliente.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lucas <onboarding@resend.dev>

# ─── Telegram (Lucas) ─────────────────────────────────────────────────
# Token de @BotFather. El secret valida que el webhook viene de Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Código que el equipo manda con /vincular <código> para usar a Lucas.
TELEGRAM_LINK_CODE=

# ─── IA (Vercel AI Gateway) ──────────────────────────────────────────
# En Vercel basta OIDC; en local hace falta la llave del AI Gateway.
AI_GATEWAY_API_KEY=
# "proveedor/modelo" del catálogo de AI Gateway
AI_MODEL=anthropic/claude-opus-5
AI_LIMITE_MS=120000

# ─── Metrics (solo lectura) ─────────────────────────────────────────
# Usuario de Atlas con rol "read" sobre la base de metrics-bakano-backapp.
METRICS_DB_URI=
METRICS_DB_NAME=test

# ─── Finanzas (cobros y links de pago de Stripe) ────────────────────
FINANCES_API_URL=
# Mismo valor que METRICS_PROXY_KEY de finances/metrics (header x-metrics-key)
FINANCES_PORTAL_KEY=
PAGO_RETURN_URL=https://bakano.ec

# ─── Lucas ────────────────────────────────────────────────────────────
# Conversaciones anteriores que Lucas lee por defecto (cada operador lo cambia con /contexto).
LUCAS_DEFAULT_CONTEXT=3
# Horas de silencio tras las que se abre una conversación nueva.
LUCAS_CONVERSATION_GAP_HOURS=12
# Minutos sin respuesta a un cliente (Telegram Business) antes de avisar al equipo
LUCAS_SLA_MINUTOS=60

# Vercel Cron manda Authorization: Bearer CRON_SECRET a /api/cron/lucas
CRON_SECRET=
# Frontend de Metrics (links a Integraciones de cada cliente)
METRICS_APP_URL=https://metrics.bakano.ec
