{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/lucas",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/revision-diaria",
      "schedule": "0,15,30,45 2,3 * * *"
    }
  ]
}
